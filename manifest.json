{
  "manifest_version": 3,
  "name": "Better Orbi",
  "version": "1.1.3",
  "description": "A dark theme and local device table sorting for the Orbi router interface.",
  "icons": {
    "16": "icons/better-orbi-16.png",
    "32": "icons/better-orbi-32.png",
    "48": "icons/better-orbi-48.png",
    "128": "icons/better-orbi-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://orbilogin.local/*",
        "*://orbilogin.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "attached-devices-sort.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://orbilogin.local/*",
        "*://orbilogin.com/*"
      ],
      "js": [
        "attached-devices-offline.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
